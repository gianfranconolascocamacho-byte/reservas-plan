{
    "name": "gianfranco/reservas",
    "description": "API y gestión de reservas de alojamiento en PHP nativo",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    }
}
